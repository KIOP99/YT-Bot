# ═══════════════════════════════════════════════════════════════
#  YTBot Dashboard — Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit your actual .env to source control.
# ═══════════════════════════════════════════════════════════════

# ── Application ─────────────────────────────────────────────────
APP_ENV=development              # development | production
APP_SECRET_KEY=change_me_to_a_random_64_char_hex_string
APP_HOST=0.0.0.0
APP_PORT=25569
APP_BASE_URL=http://www.luminaa.site:25569

# ── Database ────────────────────────────────────────────────────
# SQLite (default for dev):
DATABASE_URL=sqlite+aiosqlite:///./ytbot.db
# PostgreSQL (recommended for production):
# DATABASE_URL=postgresql+asyncpg://user:password@db:5432/ytbot

# ── Authentication (Google OAuth Only) ──────────────────────────
ALLOWED_GOOGLE_EMAILS=your_email@gmail.com,admin2@gmail.com

# ── JWT / Sessions ──────────────────────────────────────────────
JWT_SECRET=change_me_to_another_random_64_char_hex_string
JWT_ALGORITHM=HS256
SESSION_EXPIRE_MINUTES=1440        # 24 hours

# ── Encryption (Fernet key for OAuth tokens) ────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=your_fernet_key_here

# ── Discord Bot ─────────────────────────────────────────────────
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_ADMIN_USER_ID=123456789012345678  # Your Discord user ID (for DMs)
DISCORD_GUILD_ID=123456789012345678       # Your server ID
DISCORD_ANNOUNCEMENT_CHANNEL_ID=123456789012345678

# ── YouTube / Google OAuth ──────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://www.luminaa.site:25569/api/channels/oauth/callback
GOOGLE_LOGIN_REDIRECT_URI=http://www.luminaa.site:25569/auth/google/callback

# ── Scheduling ──────────────────────────────────────────────────
SCHEDULER_TIMEZONE=US/Eastern      # pytz timezone string
UPLOAD_WINDOW_START=14             # Hour (24h) — earliest upload time
UPLOAD_WINDOW_END=20               # Hour (24h) — latest upload time
PROCESSING_LEAD_MINUTES=30         # Minutes before upload to start FFmpeg

# ── FFmpeg ──────────────────────────────────────────────────────
FFMPEG_PATH=ffmpeg                 # path to ffmpeg binary
FFPROBE_PATH=ffprobe

# ── Rate Limiting ───────────────────────────────────────────────
RATE_LIMIT_LOGIN=5/minute          # Max login attempts per minute per IP
RATE_LIMIT_API=60/minute

# ── File Upload Limits ──────────────────────────────────────────
MAX_VIDEO_SIZE_MB=4096             # 4 GB
MAX_THUMBNAIL_SIZE_MB=10

# ── 2FA (optional TOTP) ─────────────────────────────────────────
TOTP_ENABLED=false
TOTP_ISSUER=YTBotDashboard

# ── Redis (optional, used if Celery backend is preferred) ────────
# REDIS_URL=redis://redis:6379/0

# ── Logging ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/ytbot.log
